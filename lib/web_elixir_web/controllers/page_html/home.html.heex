<div class="py-12">
  <!-- Hero Section -->
  <div class="text-center mb-16">
    <h1 class="text-5xl font-bold text-white mb-6">
      Gestión de <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400">Productos</span>
    </h1>
    <p class="text-xl text-gray-400 max-w-2xl mx-auto mb-8">
      Sistema CRUD completo construido con Phoenix, PostgreSQL y Tailwind CSS. 
      Rápido, moderno y desplegado en Fly.io.
    </p>
    <div class="flex justify-center gap-4">
      <a href="/products" class="bg-gradient-to-r from-purple-500 to-pink-500 text-white px-8 py-3 rounded-xl font-semibold hover:opacity-90 transition shadow-lg shadow-purple-500/25">
        Ver Productos
      </a>
      <a href="/products/new" class="bg-white/10 text-white px-8 py-3 rounded-xl font-semibold hover:bg-white/20 transition border border-white/20">
        Crear Producto
      </a>
    </div>
  </div>

  <!-- Features -->
  <div class="grid md:grid-cols-3 gap-6 mb-16">
    <div class="bg-white/5 backdrop-blur-lg rounded-2xl p-6 border border-white/10">
      <div class="w-12 h-12 bg-purple-500/20 rounded-xl flex items-center justify-center mb-4">
        <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-white mb-2">Ultra Rápido</h3>
      <p class="text-gray-400">Phoenix y Elixir ofrecen tiempos de respuesta en microsegundos.</p>
    </div>

    <div class="bg-white/5 backdrop-blur-lg rounded-2xl p-6 border border-white/10">
      <div class="w-12 h-12 bg-pink-500/20 rounded-xl flex items-center justify-center mb-4">
        <svg class="w-6 h-6 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-white mb-2">PostgreSQL</h3>
      <p class="text-gray-400">Base de datos robusta y confiable para tus productos.</p>
    </div>

    <div class="bg-white/5 backdrop-blur-lg rounded-2xl p-6 border border-white/10">
      <div class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center mb-4">
        <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-white mb-2">Fly.io</h3>
      <p class="text-gray-400">Desplegado globalmente cerca de tus usuarios.</p>
    </div>
  </div>

  <!-- Stats -->
  <div class="bg-white/5 backdrop-blur-lg rounded-2xl p-8 border border-white/10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div>
        <div class="text-3xl font-bold text-white">~1ms</div>
        <div class="text-gray-400 text-sm">Tiempo de respuesta</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-white">100%</div>
        <div class="text-gray-400 text-sm">Uptime</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-white">CRUD</div>
        <div class="text-gray-400 text-sm">Completo</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-white">API</div>
        <div class="text-gray-400 text-sm">REST incluida</div>
      </div>
    </div>
  </div>
</div>
