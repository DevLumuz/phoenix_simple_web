<div class="max-w-xl mx-auto">
  <a href={~p"/products"} class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition mb-6">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
    </svg>
    Volver a productos
  </a>

  <div class="bg-white/5 backdrop-blur-lg rounded-2xl p-8 border border-white/10">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-white">Editar Producto</h1>
      <p class="text-gray-400">Modifica los datos de "<%= @product.name %>"</p>
    </div>

    <.product_form changeset={@changeset} action={~p"/products/#{@product}"} />
  </div>
</div>
