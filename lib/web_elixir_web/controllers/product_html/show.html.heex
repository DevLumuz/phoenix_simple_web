<div class="max-w-2xl mx-auto">
  <.flash_group flash={@flash} />

  <a href={~p"/products"} class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition mb-6">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
    </svg>
    Volver a productos
  </a>

  <div class="bg-white/5 backdrop-blur-lg rounded-2xl border border-white/10 overflow-hidden">
    <!-- Header con gradiente -->
    <div class="bg-gradient-to-r from-purple-500 to-pink-500 p-8">
      <div class="flex items-center gap-4">
        <div class="w-20 h-20 bg-white/20 rounded-2xl flex items-center justify-center text-white font-bold text-3xl">
          <%= String.first(@product.name) %>
        </div>
        <div>
          <h1 class="text-3xl font-bold text-white"><%= @product.name %></h1>
          <p class="text-white/80">ID: #<%= @product.id %></p>
        </div>
      </div>
    </div>

    <!-- Contenido -->
    <div class="p-8 space-y-6">
      <div>
        <label class="text-sm text-gray-400 uppercase tracking-wider">Descripción</label>
        <p class="text-white text-lg mt-1"><%= @product.description || "Sin descripción" %></p>
      </div>

      <div class="grid grid-cols-2 gap-6">
        <div class="bg-white/5 rounded-xl p-4">
          <label class="text-sm text-gray-400 uppercase tracking-wider">Precio</label>
          <p class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-400 mt-1">
            $<%= @product.price %>
          </p>
        </div>
        <div class="bg-white/5 rounded-xl p-4">
          <label class="text-sm text-gray-400 uppercase tracking-wider">Stock</label>
          <p class="text-3xl font-bold text-white mt-1">
            <%= @product.stock %> <span class="text-lg text-gray-400">unidades</span>
          </p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-6 text-sm">
        <div>
          <label class="text-gray-400">Creado</label>
          <p class="text-white"><%= Calendar.strftime(@product.inserted_at, "%d/%m/%Y %H:%M") %></p>
        </div>
        <div>
          <label class="text-gray-400">Actualizado</label>
          <p class="text-white"><%= Calendar.strftime(@product.updated_at, "%d/%m/%Y %H:%M") %></p>
        </div>
      </div>

      <!-- Acciones -->
      <div class="flex gap-3 pt-4 border-t border-white/10">
        <a href={~p"/products/#{@product}/edit"} class="flex-1 bg-gradient-to-r from-purple-500 to-pink-500 text-white py-3 rounded-xl font-semibold hover:opacity-90 transition text-center">
          Editar Producto
        </a>
        <.link href={~p"/products/#{@product}"} method="delete" data-confirm="¿Estás seguro de eliminar este producto?" class="px-6 py-3 rounded-xl bg-red-500/20 text-red-400 hover:bg-red-500/30 transition font-semibold">
          Eliminar
        </.link>
      </div>
    </div>
  </div>
</div>
