<div class="max-w-2xl mx-auto py-8 px-4">
  <.flash_group flash={@flash} />

  <div class="bg-white shadow-md rounded-lg p-6">
    <h1 class="text-3xl font-bold text-gray-800 mb-6"><%= @product.name %></h1>

    <div class="space-y-4">
      <div>
        <span class="text-sm font-medium text-gray-500">Descripción</span>
        <p class="text-gray-800"><%= @product.description || "Sin descripción" %></p>
      </div>

      <div>
        <span class="text-sm font-medium text-gray-500">Precio</span>
        <p class="text-2xl font-bold text-green-600">$<%= @product.price %></p>
      </div>

      <div>
        <span class="text-sm font-medium text-gray-500">Stock</span>
        <p class="text-gray-800"><%= @product.stock %> unidades</p>
      </div>
    </div>

    <div class="mt-8 flex space-x-4">
      <a href={~p"/products/#{@product}/edit"} class="bg-yellow-500 hover:bg-yellow-600 text-white font-semibold py-2 px-4 rounded-lg transition">
        Editar
      </a>
      <.link href={~p"/products/#{@product}"} method="delete" data-confirm="¿Estás seguro?" class="bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-4 rounded-lg transition">
        Eliminar
      </.link>
      <a href={~p"/products"} class="bg-gray-500 hover:bg-gray-600 text-white font-semibold py-2 px-4 rounded-lg transition">
        Volver
      </a>
    </div>
  </div>
</div>
