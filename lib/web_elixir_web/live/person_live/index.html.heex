<div class="space-y-6">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-white">Personas</h1>
      <p class="text-gray-400 mt-1">
        <span class="inline-flex items-center gap-1 text-green-400">
          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
          LiveView - Sin recargas de página
        </span>
      </p>
    </div>
    <.link patch={~p"/people/new"} class="bg-gradient-to-r from-cyan-500 to-blue-500 text-white px-6 py-3 rounded-xl font-semibold hover:opacity-90 transition shadow-lg shadow-cyan-500/25 flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Nueva Persona
    </.link>
  </div>

  <%= if @live_action in [:new, :edit] do %>
    <.modal id="person-modal" show on_cancel={JS.patch(~p"/people")}>
      <.live_component
        module={WebElixirWeb.PersonLive.FormComponent}
        id={@person.id || :new}
        title={@page_title}
        action={@live_action}
        person={@person}
        patch={~p"/people"}
      />
    </.modal>
  <% end %>

  <%= if Enum.empty?(@streams.people) do %>
    <div class="bg-white/5 backdrop-blur-lg rounded-2xl p-12 border border-white/10 text-center">
      <div class="w-16 h-16 bg-cyan-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <h3 class="text-xl font-semibold text-white mb-2">No hay personas</h3>
      <p class="text-gray-400 mb-6">Comienza agregando la primera persona</p>
      <.link patch={~p"/people/new"} class="inline-flex items-center gap-2 bg-gradient-to-r from-cyan-500 to-blue-500 text-white px-6 py-3 rounded-xl font-semibold hover:opacity-90 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Crear Persona
      </.link>
    </div>
  <% else %>
    <div class="grid gap-4" id="people" phx-update="stream">
      <div :for={{id, person} <- @streams.people} id={id} class="bg-white/5 backdrop-blur-lg rounded-2xl p-6 border border-white/10 hover:bg-white/10 transition group">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 bg-gradient-to-br from-cyan-500 to-blue-500 rounded-xl flex items-center justify-center text-white font-bold text-xl">
              <%= String.first(person.name) %>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-white"><%= person.name %></h3>
              <p class="text-gray-400 text-sm"><%= person.email %></p>
            </div>
          </div>
          
          <div class="flex items-center gap-6">
            <div class="text-right">
              <div class="text-lg text-white"><%= person.age || "-" %> años</div>
              <div class="text-sm text-gray-400"><%= person.phone || "Sin teléfono" %></div>
            </div>
            
            <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition">
              <.link patch={~p"/people/#{person}/edit"} class="p-2 rounded-lg bg-yellow-500/20 text-yellow-400 hover:bg-yellow-500/30 transition" title="Editar">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
              </.link>
              <button phx-click="delete" phx-value-id={person.id} data-confirm="¿Eliminar esta persona?" class="p-2 rounded-lg bg-red-500/20 text-red-400 hover:bg-red-500/30 transition" title="Eliminar">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
